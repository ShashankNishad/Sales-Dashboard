<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <system.webServer>

        <handlers>
            <add name="FlaskHandler"
                 path="*"
                 verb="*"
                 modules="FastCgiModule"
                 scriptProcessor="C:\Users\shashank\Sales-Dashboard\CollectionDashboard Shashank\venv\Scripts\python.exe|C:\Users\shashank\Sales-Dashboard\CollectionDashboard Shashank\venv\Lib\site-packages\wfastcgi.py"
                 resourceType="Unspecified" />
        </handlers>

    </system.webServer>

    <appSettings>
        <add key="PYTHONPATH"
             value="C:\Users\shashank\Sales-Dashboard\CollectionDashboard Shashank" />

        <add key="WSGI_HANDLER"
             value="app.app" />
    </appSettings>

</configuration>